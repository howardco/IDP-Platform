# Copy this file to .env and fill in the two keys below. Everything else has
# a working default baked into docker-compose.yml — this stack runs on an
# internal Docker network nothing external reaches, so those aren't secrets
# a deployer needs to choose, just fixed internal values.
#
#   cp .env.example .env
#   docker compose up -d

# Real OpenAI API key — powers IDP-Engine's chat/strategy-execution LLM calls.
OPENAI_API_KEY=

# Real Serper.dev API key — powers IDP-WebSearch's web search tool.
SERPER_API_KEY=
